# SIKAGESTION - Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ces variables sont aussi à configurer dans Coolify → Environment Variables

# ── SUPABASE (OBLIGATOIRE) ────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AUTHENTIFICATION ─────────────────────────────────────
# Identifiants Super Admin Fantôme (accès d'urgence)
# Le mot de passe doit être hashé avec SHA-256 + salt
# Pour générer: ouvrez la console navigateur et exécutez:
#   const encoder = new TextEncoder();
#   const data = encoder.encode('votre_mot_de_passe' + 'votre_salt');
#   const hashBuffer = await crypto.subtle.digest('SHA-256', data);
#   const hashArray = Array.from(new Uint8Array(hashBuffer));
#   hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
VITE_SUPER_ADMIN_LOGIN=superadmin@sika.ci
VITE_SUPER_ADMIN_PASSWORD_HASH=votre_hash_sha256_ici

# Salt pour le hashage local (doit correspondre entre auth et gestion utilisateurs)
VITE_SIKA_SALT=sika_local_auth_salt_2024

# Clé secrète pour la gestion des utilisateurs (Edge Function)
# Doit correspondre à ADMIN_SECRET dans Supabase → Edge Functions → manage-users → Secrets
VITE_SIKA_MGMT_SECRET=sika_industrie_admin_2026_secure

# ── CONFIGURATION APPLICATION ──────────────────────────
# Mode debug (true/false) - Active les logs détaillés
VITE_DEBUG_MODE=false

# URL de l'application (pour les liens dans les emails/notifications)
VITE_APP_URL=https://sikagestion.com

# Version de l'application (affichée dans l'interface)
VITE_APP_VERSION=1.0.0

# ── FONCTIONNALITÉS OPTIONNELLES ─────────────────────────
# Activer les notifications push (true/false)
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# Clé VAPID pour les notifications push (si activées)
# VITE_VAPID_PUBLIC_KEY=votre-cle-vapid

# Activer le mode hors-line/PWA (true/false)
VITE_ENABLE_OFFLINE_MODE=true

# ── INTÉGRATIONS TIERS ─────────────────────────────────
# Clé API pour les exports PDF (si service externe utilisé)
# VITE_PDF_API_KEY=votre-cle-api

# Configuration email (si service externe utilisé)
# VITE_EMAIL_SERVICE_API_KEY=votre-cle-email
